{
  "name": "qrator-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "curate:brief": "node bin/qrator-curate.mjs brief",
    "curate:snapshot": "node bin/qrator-curate.mjs snapshot",
    "curate:harvest": "node bin/qrator-curate.mjs harvest",
    "curate:validate": "node bin/qrator-curate.mjs validate",
    "curate:publish": "node bin/qrator-curate.mjs publish",
    "audio:analyze": "node bin/qrator-audio.mjs analyze",
    "audio:analyze-tree": "node bin/qrator-audio.mjs analyze-tree",
    "audio:semantic": "node audio-semantic/worker.mjs",
    "audio:embed": "node audio-semantic/embed.mjs",
    "check": "node --check src/server.js && node --check public/app.js && node --check src/audio-perception.js && node --check bin/qrator-audio.mjs && node --check audio-semantic/worker.mjs && node --check audio-semantic/embed.mjs",
    "test": "node --test && python -m unittest discover -s test -p 'test_*.py'",
    "test:browser": "node --test browser-regression/ui_startup.browser.js"
  },
  "engines": {
    "node": ">=18"
  }
}
