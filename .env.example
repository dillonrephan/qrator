# Current Spotify integration
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Current Last.fm integration
LASTFM_API_KEY=your_lastfm_api_key_here

# Active runtime budgets
QRATOR_SPOTIFY_RESOLVE_LIMIT=12
QRATOR_MAX_RATE_LIMIT_WAIT_SECONDS=15
QRATOR_DISCOVERY_DEADLINE_SECONDS=180

# Reserved for the official SoundCloud integration described in
# docs/PLATFORM_STRATEGY.md. These settings are not wired into runtime yet.
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret_here
SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:8787/soundcloud/callback

# Unsupported, bounded public-page metadata reader. Off unless explicitly set.
# It never uses api-v2 or extracts/persists SoundCloud web-client credentials.
QRATOR_EXPERIMENTAL_SOUNDCLOUD_SCRAPE=0
SOUNDCLOUD_PUBLIC_DISCOVERY_ENABLED=false
SOUNDCLOUD_PUBLISHING_ENABLED=false

# Reserved trust-spider safety budgets. Depth/source/track enforcement is staged work.
QRATOR_TRUST_MAX_DEPTH=1
QRATOR_TRUST_MAX_SOURCES=12
QRATOR_TRUST_MAX_TRACKS_PER_SOURCE=200

PORT=8787
